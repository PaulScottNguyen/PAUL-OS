<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="PAUL OS">
    <item label="Sparrow Wallet">
      <action name="Execute">
        <command>/opt/sparrow/bin/Sparrow</command>
      </action>
    </item>
    <item label="Webcam Utility (guvcview)">
      <action name="Execute">
        <command>guvcview</command>
      </action>
    </item>
    <item label="Terminal">
      <action name="Execute">
        <command>xterm</command>
      </action>
    </item>
    <separator />
    <item label="Restart Window Manager">
      <action name="Restart" />
    </item>
    <separator />
    <item label="Reboot">
      <action name="Execute">
        <prompt>Are you sure you want to reboot PAUL OS?</prompt>
        <command>sudo systemctl reboot</command>
      </action>
    </item>
    <item label="Shutdown / Power Off">
      <action name="Execute">
        <prompt>Securely wipe RAM and shut down?</prompt>
        <command>sudo systemctl poweroff</command>
      </action>
    </item>
  </menu>
</openbox_menu>